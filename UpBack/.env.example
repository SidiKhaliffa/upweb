# MySQL - same database as the existing .NET backend, no schema changes
DB_HOST=52.47.142.28
DB_PORT=3306
DB_USER=sidi
DB_PASSWORD=Sysdba#123#
DB_NAME=up_db

# JWT - until we confirm the .NET backend's actual secret/algorithm, this
# backend issues its own tokens. Any token issued before a secret change
# becomes invalid, so existing logged-in sessions will need to re-login
# once this backend replaces the old one.
# Copy SecretKey/Issuer/Audience from the .NET appsettings.json "JWT"
# section so tokens issued by either backend are valid on both. Quote the
# values: an unquoted # starts a comment in .env files.
JWT_ACCESS_SECRET="change-me"
JWT_ISSUER=
JWT_AUDIENCE=
JWT_ACCESS_EXPIRES_IN=30m

# Refresh tokens are opaque values stored in the RefreshTokens table
# (same as the .NET backend), so they need a lifetime but no secret.
REFRESH_TOKEN_DAYS=7

PORT=3000
